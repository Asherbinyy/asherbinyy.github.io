---
import { pathFor, text, textLanguage } from '../lib/content.mjs';
const { app, locale, index, level = 'h3' } = Astro.props;
const Heading = level;
const contentPath = `apps.${index}`;
---
<article class="project-card" data-content-file="apps.json" data-content-path={contentPath}>
  <p class="eyebrow" lang="en">{app.domain}</p>
  <Heading data-content-path={`${contentPath}.name`}><a href={pathFor('project', locale, app.id)}>{app.name}<span aria-hidden="true">↗</span></a></Heading>
  {app.role && <p lang={textLanguage(app.role, locale)} data-content-path={`${contentPath}.role`}>{text(app.role, locale)}</p>}
  {app.metric && <p class="project-metric" lang="en">{app.metric}</p>}
</article>
