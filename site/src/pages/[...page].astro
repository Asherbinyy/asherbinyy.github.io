---
import Page from '../layouts/Page.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { assetUrl, loadSnapshot, pathFor, publicPages, safeUrl, text, textLanguage, ui } from '../lib/content.mjs';

export function getStaticPaths() {
  const snapshot = loadSnapshot();
  return publicPages(snapshot).map(page => ({
    params: { page: page.path.slice(1, -1) || undefined }, props: { page, snapshot },
  }));
}

const { page, snapshot } = Astro.props;
const { locale, kind } = page;
const profile = snapshot.documents['profile.json'];
const apps = snapshot.documents['apps.json'].apps;
const app = apps.find(app => app.id === page.id);
const featured = apps.filter(app => app.featured);
const relatedRoles = app ? snapshot.documents['career.json'].roles.filter(role => role.appIds?.includes(app.id)) : [];
const storeNames = { ios: ui('workAppStore', locale), android: ui('workGooglePlay', locale), pub: 'pub.dev' };
---
<Page page={page} snapshot={snapshot}>
  {kind === 'home' && <>
    <section class="hero" aria-labelledby="name" data-content-file="profile.json">
      <div class="hero-copy">
        <p class="eyebrow">{text(profile.location, locale)}</p>
        <h1 id="name" data-content-path="name">{text(profile.name, locale)}</h1>
        <p class="lead" data-content-path="positioning">{text(profile.positioning, locale)}</p>
        <div class="actions">
          <a class="button" href={pathFor('work', locale)}>{ui('heroSeeTheWork', locale)}</a>
          {profile.cvFile && <a class="text-link" href={assetUrl(profile.cvFile)}>{ui('heroDownloadTheCv', locale)}</a>}
        </div>
      </div>
      {profile.portrait?.src && !profile.portrait.isPlaceholder &&
        <figure class="portrait-frame" data-content-path="portrait">
          <img src={assetUrl(profile.portrait.src)} alt={text(profile.name, locale)} width="720" height="900" fetchpriority="high" />
          <figcaption>{text(profile.status, locale)}</figcaption>
        </figure>}
    </section>
    <section class="work-section" aria-labelledby="work">
      <div class="section-heading"><h2 id="work">{ui('navWork', locale)}</h2><a href={pathFor('work', locale)}>{ui('heroSeeTheWork', locale)}</a></div>
      <div class="project-grid">{featured.map(app => <ProjectCard app={app} locale={locale} index={apps.indexOf(app)} />)}</div>
    </section>
  </>}
  {kind === 'work' && <section class="page-section" aria-labelledby="work">
    <div class="page-intro"><p class="eyebrow">{text(profile.name, locale)}</p><h1 id="work">{ui('navWork', locale)}</h1></div>
    <div class="project-grid">{apps.map((app, index) => <ProjectCard app={app} locale={locale} index={index} level="h2" />)}</div>
  </section>}
  {kind === 'project' && app && <article class="page-section project-detail" data-content-file="apps.json" data-content-path={`apps.${apps.indexOf(app)}`}>
    <a class="text-link" href={pathFor('work', locale)}>{ui('caseStudyBackToWork', locale)}</a>
    <header class="page-intro"><p class="eyebrow" lang="en">{app.domain}</p><h1>{app.name}</h1>{app.role && <p class="lead" lang={textLanguage(app.role, locale)}>{text(app.role, locale)}</p>}</header>
    {app.metric && <p class="project-metric" lang="en">{app.metric}</p>}
    <div class="actions">{Object.entries(app.store ?? {}).filter(([, url]) => safeUrl(url)).map(([store, url]) =>
      <a class="button" href={safeUrl(url)} rel="noopener noreferrer">{storeNames[store] ?? store}</a>)}</div>
    {relatedRoles.length > 0 && <section class="project-context" aria-labelledby="journey"><h2 id="journey">{ui('navJourney', locale)}</h2>
      {relatedRoles.map(role => <div class="role-reference">
        <h3>{role.company ?? role.city}</h3>
        {role.title && <p lang={textLanguage(role.title, locale)}>{text(role.title, locale)}</p>}
        <p><bdi dir="ltr"><time datetime={role.start}>{role.start}</time>{role.end && <> — <time datetime={role.end}>{role.end}</time></>}</bdi></p>
      </div>)}
    </section>}
  </article>}
</Page>
