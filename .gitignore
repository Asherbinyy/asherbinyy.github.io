# FVM — .fvmrc IS committed, the SDK symlink is not
.fvm/

# Dart / Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
pubspec.lock          # app, not package — SDK pinned via .fvmrc instead

# Generated
*.g.dart
*.freezed.dart
*.config.dart
lib/app/l10n/generated/
coverage/
lcov.info

# Generated static routes — produced by tool/generate_static.dart
web/cv/
web/brief/
web/robots.txt
web/sitemap.xml

# Generated brand rasters — produced by tool/generate_mark.dart from the one
# committed source, assets/brand/mark.svg
web/favicon.png
web/icons/

# IDE — note the negation, see below
.idea/
.vscode/*
!.vscode/settings.json
*.iml
*.swp

# OS
.DS_Store
Thumbs.db

# Native platform dirs — web-only project, these should not exist at all
ios/
android/
macos/
windows/
linux/

# Secrets — never commit
.env
.env.*
.dev.vars
.wrangler/
**/google-services.json
**/GoogleService-Info.plist
firebase-service-account*.json
*.keystore
*.jks
key.properties

# Golden failures
**/failures/

# Agent scratch
.agent/
*.tmp

# Standalone pattern: the documented inline comment is literal to Git.
pubspec.lock

# Owner-supplied source material: CV with personal contact details, university
# coursework, LinkedIn and Medium screenshots, personal photographs. Individual
# assets may be copied into assets/ when a feature needs them; the directory
# itself never enters version control. Sources are catalogued in
# docs/14-PROVENANCE.md §0.
supporting files/

# Headless-browser scratch used to verify the WebGL intro. Never committed.
web/probe*.html
web/shot.html
